<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dnaucash_black">

    <!-- DATABASE TOGGLE -->
    <Switch
        android:id="@+id/switchDatabase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Database"
        android:textColor="@color/dnaucash_gold"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <!-- SCAN BUTTON -->
    <Button
        android:id="@+id/buttonStartScan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/dnaucash_gold"
        android:text="Scan and Log Tokens"
        android:textAllCaps="false"
        android:textColor="@color/dnaucash_black"
        android:textStyle="bold" />

    <!-- STOP BUTTON -->
    <Button
        android:id="@+id/buttonStopScan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/dnaucash_gold"
        android:text="Stop Scanning"
        android:textAllCaps="false"
        android:textColor="@color/dnaucash_black"
        android:textStyle="bold" />

    <!-- SCAN COUNT -->
    <TextView
        android:id="@+id/textPrivateKeyUnlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Database Options"
        android:textColor="@color/dnaucash_gold"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="10dp" />

    <Switch
        android:id="@+id/switchLogPrivateKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log private keys"
        android:textColor="@color/dnaucash_gold"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/textScanCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scanned: 0"
        android:textColor="@color/dnaucash_gold"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- EXPORT SCANNED -->
    <Button
        android:id="@+id/buttonExportScanned"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/dnaucash_gold"
        android:text="Export Scanned CSV"
        android:textAllCaps="false"
        android:textColor="@color/dnaucash_black"
        android:textStyle="bold" />

    <!-- EXPORT MINTED -->
    <Button
        android:id="@+id/buttonExportMinted"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="@color/dnaucash_gold"
        android:text="Export Minted CSV"
        android:textAllCaps="false"
        android:textColor="@color/dnaucash_black"
        android:textStyle="bold" />

</LinearLayout>